# HAKKIU — production reverse proxy (Caddy v2)
# Caddy terminates TLS (automatic Let's Encrypt certs) and routes each subdomain to the
# matching container on the internal `tracemark` docker network (by service name).
#
# DNS required (A records → server public IP):
#   hakkiu.com, www.hakkiu.com, admin.hakkiu.com, api.hakkiu.com, admin-api.hakkiu.com
#
# Certs + ACME state persist in the `caddy_data` volume — never delete it lightly.
{
	# Email used by Let's Encrypt for expiry warnings. Change to a mailbox you monitor.
	email admin@hakkiu.com
}

# ── Customer app (apex) ────────────────────────────────────────────────────
# Served by the customer container running the built worker under workerd (wrangler).
# The Cloudflare `public/_headers` file is NOT honoured when self-hosting, so the
# security headers + CSP are applied HERE instead. CSP mirrors public/_headers with
# the api origin pointing at api.hakkiu.com, plus Google Fonts allow-listed.
hakkiu.com {
	encode zstd gzip

	# Trailing-slash normalisation. TanStack Start strips a trailing slash with a
	# *temporary* 307, which does not consolidate link equity or resolve the
	# canonical URL for crawlers. Do it here first with a *permanent* 301 so
	# e.g. /about/ → /about is a clean, cacheable redirect. The regex requires at
	# least one character before the slash, so the root "/" is never matched.
	@trailingSlash path_regexp trailingslash ^(.+)/$
	redir @trailingSlash {re.trailingslash.1} permanent

	# Immutable caching for content-hashed static assets. Vite emits
	# /assets/<name>-<hash>.(js|css) and we self-host fonts under /fonts/*.woff2
	# — the filename changes whenever the content does, so they can be cached for
	# a year. Without this the frontend container returns `max-age=0,
	# must-revalidate`, forcing a revalidation round-trip on every repeat view
	# (a Lighthouse "efficient cache policy" finding). HTML is intentionally NOT
	# matched here so each deploy is picked up immediately.
	@immutable path /assets/* /fonts/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	header {
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://hcaptcha.com https://*.hcaptcha.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://hcaptcha.com https://*.hcaptcha.com; img-src 'self' data: blob: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://*.supabase.co https://api.hakkiu.com wss://*.supabase.co https://www.googletagmanager.com https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://hcaptcha.com https://*.hcaptcha.com; frame-src https://hcaptcha.com https://*.hcaptcha.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		# Hide upstream server banner.
		-Server
	}

	reverse_proxy frontend:8080
}

# www → apex (canonical host).
www.hakkiu.com {
	redir https://hakkiu.com{uri} permanent
}

# ── Admin frontend ─────────────────────────────────────────────────────────
# The admin container's nginx already sets its own security headers + CSP,
# so Caddy only proxies here (no duplicate headers).
admin.hakkiu.com {
	encode zstd gzip
	reverse_proxy admin:8082
}

# ── Main API (scraping / AI / customer endpoints) ──────────────────────────
api.hakkiu.com {
	encode zstd gzip

	# /internal/* endpoints are for service-to-service calls (admin-api → main-api)
	# over the private docker network only. Never expose them to the internet —
	# the app-layer secret is the real gate, this is defence-in-depth at the edge.
	@internal path /api/v1/internal/*
	respond @internal 404

	header {
		X-Content-Type-Options "nosniff"
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		Referrer-Policy "strict-origin-when-cross-origin"
		# API returns JSON only; lock down framing/embedding defensively.
		Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
		X-Frame-Options "DENY"
		# Hide upstream server banner.
		-Server
	}

	reverse_proxy api:8000
}

# ── Admin API ──────────────────────────────────────────────────────────────
admin-api.hakkiu.com {
	encode zstd gzip

	@internal path /api/v1/internal/*
	respond @internal 404

	header {
		X-Content-Type-Options "nosniff"
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
		X-Frame-Options "DENY"
		# Hide upstream server banner.
		-Server
	}

	reverse_proxy admin-api:8001
}
