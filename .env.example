# Frontend API base URL
VITE_API_URL=http://localhost:8000/api/v1

# Google Analytics 4 measurement ID (browser-exposed). Loaded only after cookie
# consent. Falls back to the live property if unset.
VITE_GA_MEASUREMENT_ID=G-PH8369N5PD

# hCaptcha SITE key (browser-exposed, safe to publish). Enables the anti-brute-force
# CAPTCHA on both login forms (customer app + admin portal). Leave BLANK to disable
# the widget for local dev. When set, you MUST also paste the hCaptcha SECRET key into
# Supabase -> Authentication -> Attack Protection -> Enable CAPTCHA (hCaptcha), or
# Supabase will reject every login with "captcha verification process failed".
# Get free keys at https://dashboard.hcaptcha.com (Sitekey + Secret).
VITE_HCAPTCHA_SITE_KEY=

# Gemini API Credentials
GEMINI_API_KEY=your_gemini_api_key_here

# Firecrawl API Credentials
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# Supabase API credentials (For Frontend & Backend)
SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_URL=your_supabase_api_url
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_public_key

# Supabase Service Role Key (Backend ONLY - NEVER expose to frontend)
SUPABASE_SECRET_KEY=your_supabase_service_role_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Meta Ads Library API (free Meta developer account — https://developers.facebook.com)
META_ADS_ACCESS_TOKEN=your_meta_ads_access_token
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret

GOOGLE_SERP_API=your_google_serp_api_key

SEARCHCANS_API=your_searchcans_api_key

# Google Ads Transparency API (no key required for basic queries)
# GOOGLE_ADS_API_KEY=your_google_ads_api_key

# Etsy API (optional — enables structured Etsy search)
# Get a key at https://www.etsy.com/developers
# ETSY_API_KEY=your_etsy_api_key

# eBay Finding API (optional — enables structured eBay search)
# Get credentials at https://developer.ebay.com
# EBAY_APP_ID=your_ebay_app_id

# Alibaba Group TOP API (optional — enables structured search for Alibaba & AliExpress)
# Register at https://open.alibaba.com or https://open.taobao.com
# ALIBABA_APP_KEY=your_alibaba_app_key
# ALIBABA_APP_SECRET=your_alibaba_app_secret
# ALIEXPRESS_APP_KEY=your_aliexpress_app_key
# ALIEXPRESS_APP_SECRET=your_aliexpress_app_secret
# ── Admin Portal (apps/admin-api + apps/admin) ──────────────────────────────
# One shared .env for the whole monorepo. Only VITE_* are exposed to browsers;
# the rest stay server-side. Backends load this file via find_dotenv(); the admin
# frontend reads it via envDir; the customer app (repo root) reads it natively.
INTERNAL_API_SECRET=change-me-to-a-long-random-string   # must be identical for main API + admin API
MAIN_API_URL=http://localhost:8000/api/v1               # admin-api → main API (internal calls)
CUSTOMER_APP_URL=http://localhost:8080                  # impersonate redirect target
ADMIN_ALLOWED_ORIGINS=                                  # extra CORS origins for admin-api (optional)
VITE_ADMIN_API_URL=http://localhost:8001/api/v1         # admin frontend → admin API
# ALLOWED_ORIGINS= (main API extra CORS origins, optional)

# ── Runtime environment & ops ───────────────────────────────────────────────
# "production" disables API docs, gates CORS to prod origins, and hardens defaults.
ENVIRONMENT=development
# Comma-separated CIDRs allowed to call /internal/* (in addition to the shared
# secret). Loopback + the pinned docker bridge subnet (172.28.0.0/16, see
# docker-compose ipam) are already trusted by default; set this only to add more.
INTERNAL_API_ALLOWED_IPS=
# Transactional email (Resend). Required for ANY outbound email (leads, digests,
# takedown notices). Without it the app silently cannot send mail.
RESEND_API_KEY=re_bfjDabPH_L2GZZsk7L45vmxuLxnJBELsd
EMAIL_FROM=HAKKIU <support@hakkiu.com>
# Base URL used to build links inside emails (e.g. dashboard/case links).
EMAIL_BASE_URL=http://localhost:8080
# Comma-separated staff emails notified of new leads / ops alerts.
ADMIN_EMAILS=
LEADS_NOTIFY_EMAILS=
# Rate limit for the public leads endpoint (slowapi format, e.g. "3/hour").
LEADS_RATE_LIMIT=3/hour
# Scrape-cache freshness window in hours.
SCRAPE_CACHE_TTL_HOURS=24
# One-time super-admin seed for the admin portal (apps/admin-api seed script).
SEED_ADMIN_EMAIL=you@example.com
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_PASSWORD=change-me-strong-password

# ── Slack lead notifications (optional) ─────────────────────────────────────
# Incoming-webhook URLs so new leads also post to Slack. TWO SEPARATE channels:
# demo bookings (source=request_demo) vs call/sales requests (source=call_request).
# Create at https://api.slack.com/apps → Incoming Webhooks → Add New Webhook.
# Leave unset to skip Slack posting cleanly (email + DB insert still happen).
# SLACK_WEBHOOK_DEMO=https://hooks.slack.com/services/XXX/YYY/ZZZ
# SLACK_WEBHOOK_CALL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# ── Slack interactive "Confirm demo" button (optional) ──────────────────────
# Lets staff confirm a demo slot + paste the meeting link straight from Slack (the
# demo notification gets a button → opens a modal → confirms + emails the customer).
# Needs a real Slack app (NOT just a webhook):
#   1. https://api.slack.com/apps → your app → "Basic Information" → copy Signing Secret.
#   2. "OAuth & Permissions" → add bot scope `chat:write` → Install → copy Bot Token (xoxb-).
#   3. "Interactivity & Shortcuts" → ON → Request URL:
#        https://<your-api-domain>/api/v1/slack/interactions
# Leave unset to hide the button entirely (webhook posting still works).
# SLACK_SIGNING_SECRET=your_slack_app_signing_secret
# SLACK_BOT_TOKEN=xoxb-your-bot-token

# ── IMAP → Slack: forward the info@ mailbox to a Slack channel (optional) ────
# A background poller reads the info@hakkiu.com mailbox over IMAP and posts each
# new email (incl. aliases delivering into it) to SLACK_WEBHOOK_EMAIL. Dormant
# unless IMAP_EMAIL + IMAP_PASSWORD + SLACK_WEBHOOK_EMAIL are all set.
# SLACK_WEBHOOK_EMAIL=https://hooks.slack.com/services/XXX/YYY/ZZZ   # info@ + fallback
# IMAP_HOST=imap.hostinger.com
# IMAP_PORT=993
# IMAP_EMAIL=info@hakkiu.com
# IMAP_PASSWORD=your_mailbox_password
# IMAP_POLL_SECONDS=120        # how often to check (default 120)
# IMAP_MAX_PER_POLL=25         # cap forwarded per poll to avoid backlog floods
# Per-alias routing: mail sent to each alias goes to its own channel. Unset =
# that alias's mail falls back to SLACK_WEBHOOK_EMAIL (nothing is ever lost).
# SLACK_WEBHOOK_LEGAL=https://hooks.slack.com/services/XXX/YYY/ZZZ     # legal@
# SLACK_WEBHOOK_PRIVACY=https://hooks.slack.com/services/XXX/YYY/ZZZ   # privacy@
# SLACK_WEBHOOK_SECURITY=https://hooks.slack.com/services/XXX/YYY/ZZZ  # security@
# SLACK_WEBHOOK_SUPPORT=https://hooks.slack.com/services/XXX/YYY/ZZZ   # support@
