# Frontend API base URL
VITE_API_URL=http://localhost:8000/api/v1

# Google Analytics 4 measurement ID (browser-exposed). Loaded only after cookie
# consent. Falls back to the live property if unset.
VITE_GA_MEASUREMENT_ID=G-PH8369N5PD

# Gemini API Credentials
GEMINI_API_KEY=your_gemini_api_key_here

# Firecrawl API Credentials
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# Supabase API credentials (For Frontend & Backend)
SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_URL=your_supabase_api_url
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_public_key

# Supabase Service Role Key (Backend ONLY - NEVER expose to frontend)
SUPABASE_SECRET_KEY=your_supabase_service_role_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Meta Ads Library API (free Meta developer account — https://developers.facebook.com)
META_ADS_ACCESS_TOKEN=your_meta_ads_access_token
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret

GOOGLE_SERP_API=your_google_serp_api_key

SEARCHCANS_API=your_searchcans_api_key

# Google Ads Transparency API (no key required for basic queries)
# GOOGLE_ADS_API_KEY=your_google_ads_api_key

# Etsy API (optional — enables structured Etsy search)
# Get a key at https://www.etsy.com/developers
# ETSY_API_KEY=your_etsy_api_key

# eBay Finding API (optional — enables structured eBay search)
# Get credentials at https://developer.ebay.com
# EBAY_APP_ID=your_ebay_app_id

# Alibaba Group TOP API (optional — enables structured search for Alibaba & AliExpress)
# Register at https://open.alibaba.com or https://open.taobao.com
# ALIBABA_APP_KEY=your_alibaba_app_key
# ALIBABA_APP_SECRET=your_alibaba_app_secret
# ALIEXPRESS_APP_KEY=your_aliexpress_app_key
# ALIEXPRESS_APP_SECRET=your_aliexpress_app_secret
# ── Admin Portal (apps/admin-api + apps/admin) ──────────────────────────────
# One shared .env for the whole monorepo. Only VITE_* are exposed to browsers;
# the rest stay server-side. Backends load this file via find_dotenv(); the admin
# frontend reads it via envDir; the customer app (repo root) reads it natively.
INTERNAL_API_SECRET=change-me-to-a-long-random-string   # must be identical for main API + admin API
MAIN_API_URL=http://localhost:8000/api/v1               # admin-api → main API (internal calls)
CUSTOMER_APP_URL=http://localhost:8080                  # impersonate redirect target
ADMIN_ALLOWED_ORIGINS=                                  # extra CORS origins for admin-api (optional)
VITE_ADMIN_API_URL=http://localhost:8001/api/v1         # admin frontend → admin API
# ALLOWED_ORIGINS= (main API extra CORS origins, optional)

# ── Slack lead notifications (optional) ─────────────────────────────────────
# Incoming-webhook URLs so new leads also post to Slack. TWO SEPARATE channels:
# demo bookings (source=request_demo) vs call/sales requests (source=call_request).
# Create at https://api.slack.com/apps → Incoming Webhooks → Add New Webhook.
# Leave unset to skip Slack posting cleanly (email + DB insert still happen).
# SLACK_WEBHOOK_DEMO=https://hooks.slack.com/services/XXX/YYY/ZZZ
# SLACK_WEBHOOK_CALL=https://hooks.slack.com/services/XXX/YYY/ZZZ
