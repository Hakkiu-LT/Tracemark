# ===========================================================================
# HAKKIU — PRODUCTION .env template (server: hakkiu.com)
# ===========================================================================
# On the server: copy this to `.env`, then fill in every "CHANGE_ME" secret.
#   cp .env.production.example .env && nano .env
#
# The URL/origin values below are already set for the hakkiu.com domain.
# ⚠️ VITE_* values are BAKED INTO the frontend bundle at build time — after
#    changing any VITE_* you MUST rebuild the frontend/admin images.
# ⚠️ This file is a TEMPLATE (safe to commit). The real `.env` is git-ignored.
# ---------------------------------------------------------------------------

ENVIRONMENT=production

# ── Public URLs / CORS (production domain) ─────────────────────────────────
# Customer frontend → main API
VITE_API_URL=https://api.hakkiu.com/api/v1
# Admin frontend → admin API
VITE_ADMIN_API_URL=https://admin-api.hakkiu.com/api/v1
# Main API allowed CORS origins (customer app lives at the apex)
ALLOWED_ORIGINS=https://hakkiu.com,https://www.hakkiu.com
# Admin API allowed CORS origins
ADMIN_ALLOWED_ORIGINS=https://admin.hakkiu.com
# Impersonate redirect target (admin-api → customer app)
CUSTOMER_APP_URL=https://hakkiu.com
# admin-api → main API over the internal docker network (NOT the public URL)
MAIN_API_URL=http://api:8000/api/v1

# ── Supabase (external, hosted) ────────────────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=CHANGE_ME_supabase_anon_public_key
# Backend ONLY — never exposed to the browser.
SUPABASE_SECRET_KEY=CHANGE_ME_supabase_service_role_key
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME_supabase_service_role_key

# hCaptcha SITE key (browser-safe) — anti-brute-force CAPTCHA on both login forms.
# BUILD-TIME var: baked into the JS bundle by docker compose build, so it must be
# in this .env BEFORE `docker compose build` runs. Also paste the matching SECRET
# into Supabase → Authentication → Attack Protection → Enable CAPTCHA (hCaptcha),
# or tokens are sent but never verified. Free keys: https://dashboard.hcaptcha.com
VITE_HCAPTCHA_SITE_KEY=CHANGE_ME_hcaptcha_site_key

# ── Shared internal secret (main API ⇄ admin API) ──────────────────────────
# Generate: openssl rand -hex 32   — must be IDENTICAL for both APIs.
INTERNAL_API_SECRET=CHANGE_ME_long_random_string

# ── AI / scraping providers ────────────────────────────────────────────────
GEMINI_API_KEY=CHANGE_ME
FIRECRAWL_API_KEY=CHANGE_ME
GOOGLE_SERP_API=CHANGE_ME
SEARCHCANS_API=CHANGE_ME

# ── Meta Ads Library ───────────────────────────────────────────────────────
META_ADS_ACCESS_TOKEN=CHANGE_ME
META_APP_ID=CHANGE_ME
META_APP_SECRET=CHANGE_ME

# ── Backups (optional — Hetzner Storage Box) ───────────────────────────────
# Direct Postgres connection string from Supabase → Settings → Database.
# DATABASE_URL=postgresql://postgres:PASSWORD@db.your-project-ref.supabase.co:5432/postgres
# Hetzner Storage Box SSH target for off-site backups.
# BACKUP_SSH_TARGET=uXXXXXX@uXXXXXX.your-storagebox.de

# --- Resend Email ---
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=info@hakkiu.com

# --- Slack lead notifications (optional) ---
# New leads also post to Slack. TWO SEPARATE channels: demo bookings
# (source=request_demo) vs call/sales requests (source=call_request).
# Create at https://api.slack.com/apps → Incoming Webhooks. Unset = skipped.
# SLACK_WEBHOOK_DEMO=https://hooks.slack.com/services/XXX/YYY/ZZZ
# SLACK_WEBHOOK_CALL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# --- Slack interactive "Confirm demo" button (optional) ---
# Confirm a demo slot + paste the meeting link from Slack. Needs a real Slack app:
# Basic Information → Signing Secret; OAuth → bot scope chat:write → Bot Token (xoxb-);
# Interactivity → Request URL: https://<api-domain>/api/v1/slack/interactions
# SLACK_SIGNING_SECRET=your_slack_app_signing_secret
# SLACK_BOT_TOKEN=xoxb-your-bot-token

# --- IMAP -> Slack: forward the info@ mailbox to a Slack channel (optional) ---
# Background poller reads info@hakkiu.com over IMAP and posts each new email to
# SLACK_WEBHOOK_EMAIL. Dormant unless IMAP_EMAIL + IMAP_PASSWORD + webhook set.
# SLACK_WEBHOOK_EMAIL=https://hooks.slack.com/services/XXX/YYY/ZZZ   # info@ + fallback
# IMAP_HOST=imap.hostinger.com
# IMAP_PORT=993
# IMAP_EMAIL=info@hakkiu.com
# IMAP_PASSWORD=your_mailbox_password
# IMAP_POLL_SECONDS=120
# IMAP_MAX_PER_POLL=25
# Per-alias routing (unset -> falls back to SLACK_WEBHOOK_EMAIL):
# SLACK_WEBHOOK_LEGAL=https://hooks.slack.com/services/XXX/YYY/ZZZ     # legal@
# SLACK_WEBHOOK_PRIVACY=https://hooks.slack.com/services/XXX/YYY/ZZZ   # privacy@
# SLACK_WEBHOOK_SECURITY=https://hooks.slack.com/services/XXX/YYY/ZZZ  # security@
# SLACK_WEBHOOK_SUPPORT=https://hooks.slack.com/services/XXX/YYY/ZZZ   # support@
