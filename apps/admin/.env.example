# Admin frontend (Vite) — build-time inlined VITE_* vars.
# Staff authenticate against the SAME Supabase project as customers.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-publishable-key

# The admin backend (apps/admin-api). Local dev default is :8001.
VITE_ADMIN_API_URL=http://localhost:8001/api/v1
