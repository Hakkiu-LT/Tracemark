# Admin backend (apps/admin-api) environment.

# Same Supabase project as the main API (staff live here too, marked by staff_accounts).
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shared secret for calling the main API's /internal/* endpoints. MUST match the value
# set on the main API. Generate a long random string.
INTERNAL_API_SECRET=change-me-to-a-long-random-string

# Where the main Tracemark API lives (for service-to-service calls).
MAIN_API_URL=http://localhost:8000/api/v1

# Extra allowed CORS origins (comma-separated) beyond localhost:8082 + admin.tracemark.ai.
ADMIN_ALLOWED_ORIGINS=

ENVIRONMENT=development

# Where the CUSTOMER app runs (impersonate redirect target). Must be in the Supabase
# project auth redirect allow-list. Dev: http://localhost:8080
CUSTOMER_APP_URL=http://localhost:8080
